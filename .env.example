# ============================================
# Sentinel EvacOS Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with actual credentials.

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Backend ----------
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# ---------- Supabase ----------
# Get these from your Supabase project dashboard:
# https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=
# Public/client key; safe for backend use and never needed in NEXT_PUBLIC_* here.
SUPABASE_PUBLISHABLE_KEY=
# Server-side privileged key. Never expose to the frontend.
SUPABASE_SECRET_KEY=
# JWT verification metadata only; not a PostgreSQL connection string.
SUPABASE_JWKS_URL=
# PostgreSQL URI from Supabase Dashboard → Connect → Transaction pooler.
# Keep server-side only; do not substitute SUPABASE_JWKS_URL.
SUPABASE_DB_URL=

# SECURITY NOTES:
# - SUPABASE_SECRET_KEY is backend-only. NEVER expose it to the frontend.
# - Only variables prefixed with NEXT_PUBLIC_ are accessible in browser code.
# - In production, set CORS_ORIGINS to your actual Vercel domain.
