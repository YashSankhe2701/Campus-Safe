# ============================================
# CAMPUS-SAFE Frontend Environment Variables
# ============================================
# Copy this file to .env.local for local frontend development.
# In Vercel, set these in Project Settings -> Environment Variables.

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase public credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Campus UUID identifier
NEXT_PUBLIC_CAMPUS_ID=10000000-0000-4000-8000-000000000001
