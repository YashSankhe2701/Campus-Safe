# ============================================
# CAMPUS-SAFE .gitignore
# ============================================

# ---------- Node.js / Next.js ----------
node_modules/
.next/
out/
.vercel/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg

# ---------- Virtual Environments ----------
.venv/
venv/
ENV/

# ---------- Environment Variables ----------
.env
.env.*
!.env.example

# ---------- IDE / Editor ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------- OS ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# ---------- Build / Cache ----------
*.log
.cache/
.pytest_cache/
.mypy_cache/
htmlcov/
.coverage
coverage.xml

# ---------- Rocketride ----------
.rocketride/

# ---------- Claude ----------
.claude/

# ---------- Local ML experiment and deployment artifacts ----------
ai/prediction/artifacts/
backend/artifacts/*
!backend/artifacts/.gitkeep
*.joblib
